OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here
# 選填：若 Notion 資料庫欄位名稱與程式預設不一致，可手動指定欄位名稱
# NOTION_PROPERTY_TITLE=
# NOTION_PROPERTY_CATEGORY=
# NOTION_PROPERTY_TICKERS=
# NOTION_PROPERTY_REPORT_DATE=

# Render / Neon 等使用 postgresql://… 即可；程式會轉成非同步連線。
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 上傳／刪除 API 防護（本機可留空；正式環境請設隨機長字串並設 REQUIRE_UPLOAD_API_KEY=true）
# UPLOAD_API_KEY=your_random_upload_key_here
# REQUIRE_UPLOAD_API_KEY=false
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_RATE_LIMIT=5/minute
